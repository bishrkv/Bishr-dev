rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000;
    }

    match /site/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if true;
    }
  }
}
